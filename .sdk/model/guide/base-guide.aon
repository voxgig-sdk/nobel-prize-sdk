# Guide

guide: {
  metrics: count: entity: 2
  metrics: count: path: 2
  metrics: count: method: 2

  entity: laureate: {
    path: "/laureate.json": {
      op: list: method: *GET
      op: list: transform: res: *("`body.laureates`")|top
    }
  }

  entity: prize: {
    path: "/prize.json": {
      op: list: method: *GET
      op: list: transform: res: *("`body.prizes`")|top
    }
  }

}